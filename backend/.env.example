# Database Connection (PostgreSQL connection string; e.g., Supabase, Neon, Railway, Render or local Postgres)
# Example PostgreSQL URL: postgresql://username:password@localhost:5432/sellsense_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sellsense_db

# JWT Secret Key for Session Authentication & Token Signing
JWT_SECRET=sellsense_super_secret_jwt_key_2026_change_in_production

# Server Configuration
PORT=5000

# OpenAI API Key (Optional: system uses smart fallback engine if unconfigured)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Razorpay Test Mode Credentials
# Find these in Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_AiBuildathon2026
RAZORPAY_KEY_SECRET=SecretBuildathonKey2026

